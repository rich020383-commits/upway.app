generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Base de datos: Aiven PostgreSQL (migrado desde Neon, que agoto su capa
  // gratuita). Aiven entrega un unico endpoint directo: no hay endpoint de
  // pooler separado, asi que `url` sirve tanto para la app como para las tareas
  // de esquema (prisma migrate / db push).
  //
  // Antes existia `directUrl = env("DIRECT_URL")` porque Neon separaba pooler y
  // endpoint directo. Se elimino para no dejar un puntero que, si queda viejo en
  // el entorno, intentaria migrar contra una base de datos que ya no existe.
  //
  // Los alias tolerados en tiempo de ejecucion (AIVEN_DATABASE_URL, POSTGRES_URL,
  // DIRECT_URL) los resuelve lib/database-url.ts.
  //
  // Pooling: Aiven no ofrece endpoint de pooler y esta instancia tiene
  // max_connections=20 (17 usables). Como Prisma abre (cpus * 2 + 1) conexiones
  // por instancia y lib/listener.ts retiene 1 conexion permanente para
  // LISTEN/NOTIFY, conviene acotar el pool en la URL:
  //   ?sslmode=require&connection_limit=5&pool_timeout=20
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. MODELOS DE SEGURIDAD (NEXTAUTH)
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // Para que tus clientes entren con su clave

  accounts                Account[]
  sessions                Session[]
  tiendas                 Tienda[] // Enlace directo al negocio de tu cliente
  ownedOrganizations      Organization[]       @relation("OrganizationOwner")
  organizationMemberships OrganizationMember[]
  billingAccessCodes      BillingAccessCode[]  @relation("BillingAccessCodeCreator")
  leadAssignments         LeadAssignment[]     @relation("LeadAssignmentAssignee")
  leadAssignmentHistory   LeadAssignment[]     @relation("LeadAssignmentOwner")
  leadActivities          LeadActivity[]       @relation("LeadActivityActor")
  leadReminders           LeadReminder[]       @relation("LeadReminderCreator")
  voiceCloneAuthorizations VoiceCloneAuthorization[]
  appointmentAssignments  Cita[]               @relation("AppointmentAssignee")
  createdLeads            Lead[]               @relation("LeadCreator")
  assignedLeads           Lead[]               @relation("LeadAssignee")
  scheduleResources           ScheduleResource[]    @relation("ScheduleResourceUser")
  agendaHoldCreations         AppointmentHold[]     @relation("AgendaHoldCreator")
  agendaAppointmentsCreated   AgendaAppointment[]   @relation("AgendaAppointmentCreator")
  agendaAppointmentsAssigned  AgendaAppointment[]   @relation("AgendaAppointmentAssignee")
  agendaAuditEvents           AgendaAuditEvent[]    @relation("AgendaEventActor")
  verticalOnboardingSessions  VerticalOnboardingSession[]
}

enum VerticalType {
  BUSINESS
  HEALTH
  HYBRID
}

enum HealthOnboardingStatus {
  DRAFT
  IN_PROGRESS
  PENDING_REVIEW
  NEEDS_CHANGES
  APPROVED
  TESTING
  ACTIVE
  PAUSED
  BLOCKED
  ARCHIVED
}

enum HealthOnboardingStepStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  PENDING_REVIEW
  APPROVED
  REJECTED
  BLOCKED
}

enum HealthApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum BillingAccessState {
  TRIAL
  ACTIVE
  PENDING_PAYMENT
  PAUSED
  SUSPENDED
  CANCELLED
}

enum BillingAccessType {
  TRIAL
  INVITE
  GIFT
}

enum LeadSource {
  WHATSAPP
  VOICE
  WEB_FORM
  LANDING_PAGE
  REFERRAL
  MANUAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  APPOINTMENT_BOOKED
  FOLLOW_UP
  CLOSED_WON
  CLOSED_LOST
  ARCHIVED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ConversationStatus {
  ACTIVE
  WAITING
  RESOLVED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
  REBOOKED
}

enum ReminderStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum ActivityType {
  LEAD_CREATED
  LEAD_QUALIFIED
  LEAD_ASSIGNED
  MESSAGE_RECEIVED
  MESSAGE_SENT
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  REMINDER_SENT
  FOLLOW_UP_SCHEDULED
  NOTE_ADDED
  STATUS_CHANGED
}

model Organization {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  vertical  VerticalType         @default(BUSINESS)
  verticals VerticalType[]       @default([BUSINESS])
  ownerId   String
  owner     User                 @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   OrganizationMember[]
  clinics   Clinic[]
  tiendas   Tienda[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  scheduleResources  ScheduleResource[]
  serviceOfferings   ServiceOffering[]
  agendaAppointments AgendaAppointment[]
  waitlistEntries    WaitlistEntry[]
  patientIdentities  PatientIdentity[]
  apiClients         ApiClient[]
  voiceCloneAuthorizations VoiceCloneAuthorization[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("admin")
  permissions    String[]     @default([])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Clinic {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  specialty      String?
  timezone       String?      @default("UTC")
  vertical       VerticalType @default(BUSINESS)
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tiendas            Tienda[]
  healthProfile      HealthProfile?
  onboardingSessions HealthOnboardingSession[]
  auditLogs          HealthAuditLog[]
  scheduleResources  ScheduleResource[]
  serviceOfferings   ServiceOffering[]
  agendaAppointments AgendaAppointment[]
  waitlistEntries    WaitlistEntry[]
  patientIdentities  PatientIdentity[]
  apiClients         ApiClient[]
}

model HealthProfile {
  id                     String   @id @default(cuid())
  clinicId               String   @unique
  specialty              String?
  appointmentMode        String?  @default("phone")
  patientContextRequired Boolean  @default(true)
  emergencyEscalation    Boolean  @default(true)
  cancellationPolicy     String?  @db.Text
  toneProfile            String?  @default("professional")
  privacyMode            String   @default("strict")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  clinic             Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  triageRules        HealthTriageRule[]
  faqs               HealthFAQ[]
  handoffRules       HealthHandoffRule[]
  compliancePolicies HealthCompliancePolicy[]
}

model HealthOnboardingSession {
  id              String                 @id @default(cuid())
  clinicId        String
  vertical        VerticalType           @default(BUSINESS)
  status          HealthOnboardingStatus @default(DRAFT)
  currentStep     String                 @default("clinic-setup")
  progressPercent Int                    @default(0)
  notes           String?                @db.Text
  ownerUserId     String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  clinic    Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  steps     HealthOnboardingStep[]
  approvals HealthOnboardingApproval[]
}

model HealthOnboardingStep {
  id             String                     @id @default(cuid())
  sessionId      String
  stepKey        String
  title          String
  status         HealthOnboardingStepStatus @default(NOT_STARTED)
  required       Boolean                    @default(true)
  notes          String?                    @db.Text
  blockerReason  String?                    @db.Text
  assigneeUserId String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  session HealthOnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, stepKey])
}

model HealthOnboardingApproval {
  id          String               @id @default(cuid())
  sessionId   String
  entityType  String               @default("onboarding")
  entityId    String?
  requestedBy String?
  approvedBy  String?
  status      HealthApprovalStatus @default(PENDING)
  comments    String?              @db.Text
  createdAt   DateTime             @default(now())
  reviewedAt  DateTime?

  session HealthOnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
}

model HealthAuditLog {
  id          String   @id @default(cuid())
  clinicId    String
  entityType  String
  entityId    String
  action      String
  performedBy String?
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, entityType, createdAt])
}

model WebhookEventLog {
  id           String   @id @default(cuid())
  provider     String
  eventType    String
  status       String   @default("received")
  clinicId     String?
  tenantId     String?
  entityType   String?
  entityId     String?
  performedBy  String?
  payloadJson  Json?
  metadataJson Json?
  createdAt    DateTime @default(now())

  @@index([provider, createdAt])
  @@index([clinicId, createdAt])
}

model HealthTriageRule {
  id        String   @id @default(cuid())
  profileId String
  name      String
  condition String   @db.Text
  severity  String   @default("medium")
  action    String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile HealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model HealthFAQ {
  id          String   @id @default(cuid())
  profileId   String
  question    String   @db.Text
  answer      String   @db.Text
  category    String   @default("general")
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile HealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model HealthHandoffRule {
  id             String   @id @default(cuid())
  profileId      String
  triggerType    String
  destination    String
  escalationMode String   @default("human")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile HealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model HealthCompliancePolicy {
  id         String   @id @default(cuid())
  profileId  String
  title      String
  body       String   @db.Text
  version    String   @default("v1")
  isRequired Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  profile HealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model BillingAccessCode {
  id              String             @id @default(cuid())
  code            String             @unique
  label           String
  description     String?
  state           BillingAccessState @default(TRIAL)
  type            BillingAccessType  @default(TRIAL)
  allowedRole     String?            @default("clinic-admin")
  isActive        Boolean            @default(true)
  expiresAt       DateTime?
  createdByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  createdBy User? @relation("BillingAccessCodeCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([isActive, expiresAt])
  @@index([code])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// 2. MODELOS DE UPWAY BUSINESS (SAAS)
// ==========================================

model Tienda {
  id             String  @id @default(cuid())
  userId         String
  organizationId String?
  clinicId       String?
  nombre         String

  // 🏭 Segmento de negocio (inmobiliaria, drogueria, retail, supermercado, general)
  segment String @default("general")

  // 🤖 Personalidad del Bot
  agentName    String?
  systemPrompt String? @db.Text

  // 🔥 CAMPOS META WHATSAPP Y HANDOFF
  telefono          String? // El número oficial de la empresa en Meta
  telefonoAdmin     String? // Celular personal del dueño para Human Handoff
  metaPhoneNumberId String?
  metaWabaId        String?
  metaAccessToken   String? @db.Text
  isWhatsAppActive  Boolean @default(false)
  whatsappStatus    String  @default("PENDING") // 🟢 Para el letrero verde inteligente del frontend
  isAiActive        Boolean @default(true) // 🛑 Botón del panel: true = IA responde, false = Humano responde

  // 🎙️ CAMPOS TELNYX (Telefonía y Voz AI Nativa Upway)
  telnyxPhoneNumber    String?
  telnyxConnectionId   String?
  telnyxAssistantId    String?
  isTelnyxActive       Boolean @default(false)

  // 🎤 Voz del agente: catálogo Telnyx o clon propio (elegida en /health/production)
  agentVoice      String?
  agentVoiceLabel String?

  // 🗑️ CAMPOS VAPI (Legados / En proceso de retiro)
  vapiAssistantId String?
  vapiPhoneNumber String?
  isVapiActive    Boolean @default(false)

  // 🗑️ (Se eliminaron los campos de Google Calendar por el pivot estratégico)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clinic        Clinic?        @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  productos     Producto[]
  llamadas      LlamadaLog[]
  leads         Lead[]
  conversations Conversation[] // 💬 Relación con el buzón omnicanal
  citas         Cita[] // 📅 Relación con la Agenda Nativa Upway
  voiceCloneAuthorizations VoiceCloneAuthorization[] // 🗣️ Quién autorizó cada voz clonada
}

// Autorización de clonación de voz.
// Ley 1581: la voz es dato biométrico sensible y solo el TITULAR puede
// autorizarla. La sede es la BENEFICIARIA del uso, no la titular: por eso
// `tiendaId` convive con `consentingName`.
// Aquí vive la EVIDENCIA, no el audio: los hashes SHA-256 de la autorización
// y de la muestra demuestran que existieron y que no se alteraron, sin que
// Upway custodie la voz de la persona.
// Ver lib/voice-clone-consent.ts para el alcance real de esta protección.
model VoiceCloneAuthorization {
  id                  String    @id @default(cuid())
  organizationId      String
  tiendaId            String

  // Titular: la persona cuya voz se clona. Obligatorio siempre.
  consentingName      String
  consentingDocument  String?
  // Beneficiario: para qué se usa la voz.
  purpose             String
  // Texto leído y versión: permite probar qué se leyó exactamente.
  scriptVersion       String
  grantedAt           DateTime  @default(now())

  // Revocación: el derecho real de la persona a que esto termine.
  revokedAt           DateTime?
  revokeReason        String?

  // Evidencia (hashes, no audio).
  authorizationSha256 String?
  sampleSha256        String?
  sampleSeconds       Int?
  voiceCloneId        String?

  createdByUserId     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tienda       Tienda       @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, grantedAt])
  @@index([tiendaId, grantedAt])
  @@index([voiceCloneId])
  @@index([consentingDocument])
}

model Producto {
  id          String  @id @default(cuid())
  tiendaId    String
  nombre      String
  descripcion String?
  precio      Float
  stock       Int     @default(0)

  tienda Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
}

// ==========================================
// 3. MOTOR DE FACTURACIÓN (VOZ)
// ==========================================

model LlamadaLog {
  id              String   @id @default(cuid())
  tiendaId        String
  callSessionId   String?  @unique // Identificador de sesión de llamada Telnyx
  callControlId   String?  // Call Control ID de Telnyx
  vapiCallId      String?  @unique // Legado
  direction       String // "inbound" o "outbound"
  durationMinutes Float
  telnyxCost      Float    @default(0) // Lo que factura Telnyx a Upway
  vapiCost        Float?   @default(0) // Legado
  upwayBilledCost Float // Lo que Upway le cobra a la empresa o IPS (con margen)
  status          String // "completed", "failed", "no_answer", etc.
  createdAt       DateTime @default(now())

  tienda Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
}

// ==========================================
// 4. MÓDULO CRM (LEADS Y PACIENTES)
// ==========================================

model Lead {
  id               String       @id @default(cuid())
  tiendaId         String
  nombre           String
  documento        String? // Cédula, NIT o Pasaporte
  motivo           String?      @db.Text // El resumen de la consulta o intención
  origen           LeadSource   @default(WHATSAPP)
  estado           LeadStatus   @default(NEW)
  prioridad        LeadPriority @default(MEDIUM)
  phone            String?
  email            String?
  city             String?
  qualityScore     Int          @default(0)
  note             String?      @db.Text
  createdByUserId  String?
  assignedToUserId String?
  lastContactAt    DateTime?
  closedAt         DateTime?
  metadataJson     Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tienda        Tienda           @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  createdBy     User?            @relation("LeadCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignedTo    User?            @relation("LeadAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  conversations Conversation[]
  assignments   LeadAssignment[]
  activities    LeadActivity[]
  reminders     LeadReminder[]
  appointments  Cita[]

  @@index([tiendaId, estado])
  @@index([tiendaId, prioridad])
  @@index([assignedToUserId])
  agendaAppointments AgendaAppointment[] @relation("AgendaAppointmentLead")
}

model LeadAssignment {
  id               String    @id @default(cuid())
  leadId           String
  userId           String
  assignedByUserId String?
  status           String    @default("active")
  reason           String?   @db.Text
  assignedAt       DateTime  @default(now())
  unassignedAt     DateTime?

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user       User  @relation("LeadAssignmentAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("LeadAssignmentOwner", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([leadId, status])
  @@index([userId, status])
}

model LeadActivity {
  id           String       @id @default(cuid())
  leadId       String
  actorUserId  String?
  type         ActivityType
  summary      String?      @db.Text
  metadataJson Json?
  createdAt    DateTime     @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation("LeadActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([actorUserId, createdAt])
}

model LeadReminder {
  id              String         @id @default(cuid())
  leadId          String
  appointmentId   String?
  conversationId  String?
  createdByUserId String?
  channel         String         @default("whatsapp")
  status          ReminderStatus @default(PENDING)
  message         String?        @db.Text
  scheduledFor    DateTime
  sentAt          DateTime?
  createdAt       DateTime       @default(now())

  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  appointment  Cita?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("LeadReminderCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([leadId, status, scheduledFor])
  @@index([scheduledFor])
}

// ==========================================
// 5. BUZÓN OMNICANAL Y MÉTRICAS META (CHAT EN VIVO)
// ==========================================

model Conversation {
  id           String             @id @default(cuid())
  tiendaId     String
  leadId       String?
  clientPhone  String // El número de WhatsApp del cliente
  clientName   String? // Nombre del cliente
  status       ConversationStatus @default(ACTIVE)
  metaCategory String? // "service", "utility", "marketing" (Métricas de cobro Meta)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  tienda       Tienda         @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  lead         Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages     Message[]
  appointments Cita[]
  reminders    LeadReminder[]

  // Un cliente solo debería tener una conversación activa por tienda a la vez
  @@unique([tiendaId, clientPhone])
  @@index([leadId])
  agendaAppointments AgendaAppointment[] @relation("AgendaAppointmentConversation")
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  metaMessageId  String?          @unique // ID real de Meta para cruzar los estados (entregado/leído)
  senderRole     String           @default("USER") // Quién envió: "USER", "AI", "HUMAN", "SYSTEM"
  direction      MessageDirection @default(INBOUND)
  messageType    String           @default("text")
  content        String           @db.Text
  status         MessageStatus    @default(SENT) // "sent", "delivered", "read", "failed" (Check azul)
  metadataJson   Json?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ==========================================
// 6. AGENDA NATIVA UPWAY (CITAS)
// ==========================================

model Cita {
  id               String            @id @default(cuid())
  tiendaId         String
  leadId           String?
  conversationId   String?
  assignedToUserId String?
  clienteNombre    String
  clienteTelefono  String
  fechaHora        DateTime
  estado           AppointmentStatus @default(CONFIRMED)
  durationMinutes  Int               @default(30)
  location         String?
  notes            String?           @db.Text
  cancelReason     String?           @db.Text
  source           String            @default("manual")
  createdByUserId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tienda       Tienda         @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  lead         Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversation Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedTo   User?          @relation("AppointmentAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  reminders    LeadReminder[]

  @@index([tiendaId, fechaHora])
  @@index([leadId])
  @@index([conversationId])
}

// ==========================================
// 7. FLUJO DE ACTIVACIÓN (ONBOARDING → APROBACIÓN → PAGO BOLD → ENTREGA)
// ==========================================

enum ActivationPaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

model ActivationPayment {
  id            String                  @id @default(cuid())
  reference     String                  @unique // merchant_reference enviado a Bold
  planId        String
  planName      String
  amountCOP     Int
  currency      String                  @default("COP")
  status        ActivationPaymentStatus @default(PENDING)
  paymentUrl    String?                 @db.Text
  boldPaymentId String?
  paidAt        DateTime?
  expiresAt     DateTime? // Vencimiento del link de pago (BOLD_LINK_TTL_DAYS, default 7 dias)
  statusMessage String? // Último evento reportado por Bold (trazabilidad)

  customerEmail String?
  customerName  String?
  userId        String?
  organizationId String?
  clinicId      String?
  sessionId     String? // HealthOnboardingSession relacionada (flujo health)

  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([status])
  @@index([customerEmail])
  @@index([sessionId])
  @@index([clinicId])
}

// ==========================================
// 8. AGENDA PREMIUM UPWAY (nativa, sin terceros)
// Propia: disponibilidad, holds para voz, lista de espera y auditoría.
// ==========================================

enum ScheduleResourceKind {
  PROFESSIONAL
  ROOM
  EQUIPMENT
}

enum AgendaAppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
  REBOOKED
}

enum AgendaChannel {
  VOICE
  DASHBOARD
  EMAIL
  API
  WALK_IN
}

enum AvailabilityExceptionKind {
  TIME_OFF
  HOLIDAY
  EXTRA_OPENING
}

enum WaitlistStatus {
  WAITING
  OFFERED
  BOOKED
  EXPIRED
  CANCELLED
}

enum AgendaEventType {
  APPOINTMENT_CREATED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_CHECKED_IN
  APPOINTMENT_COMPLETED
  APPOINTMENT_NO_SHOW
  REMINDER_SENT
  HOLD_CREATED
  HOLD_RELEASED
  HOLD_EXPIRED
  WAITLIST_ADDED
  WAITLIST_OFFERED
  WAITLIST_CONVERTED
}

model ScheduleResource {
  id             String               @id @default(cuid())
  organizationId String
  clinicId       String?
  userId         String?
  name           String
  kind           ScheduleResourceKind @default(PROFESSIONAL)
  email          String?
  phone          String?
  timezone       String               @default("America/Bogota")
  locationLabel  String?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic?      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user         User?        @relation("ScheduleResourceUser", fields: [userId], references: [id], onDelete: SetNull)

  services     ResourceService[]
  rules        AvailabilityRule[]
  exceptions   AvailabilityException[]
  appointments AgendaAppointment[]
  holds        AppointmentHold[]
  waitlist     WaitlistEntry[]

  @@index([organizationId, isActive])
  @@index([clinicId, isActive])
}

model ServiceOffering {
  id                   String  @id @default(cuid())
  organizationId       String
  clinicId             String?
  name                 String
  code                 String?
  durationMinutes      Int     @default(30)
  bufferBeforeMinutes  Int     @default(0)
  bufferAfterMinutes   Int     @default(0)
  slotStepMinutes      Int     @default(15)
  capacity             Int     @default(1)
  requiresDocuments    Boolean @default(false)
  requiredDocumentType String?
  prepInstructions     String? @db.Text
  color                String  @default("#0EA5E9")
  isActive             Boolean @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic?      @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  resources    ResourceService[]
  rules        AvailabilityRule[]
  appointments AgendaAppointment[]
  holds        AppointmentHold[]
  waitlist     WaitlistEntry[]

  @@unique([clinicId, name])
  @@index([organizationId, isActive])
}

model ResourceService {
  id                      String   @id @default(cuid())
  resourceId              String
  serviceId               String
  durationOverrideMinutes Int?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())

  resource ScheduleResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  service  ServiceOffering  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, serviceId])
  @@index([serviceId, isActive])
}

model AvailabilityRule {
  id              String   @id @default(cuid())
  resourceId      String
  serviceId       String?
  dayOfWeek       Int // 0 = domingo ... 6 = sábado (hora local del recurso)
  startMinute     Int // minutos desde medianoche local
  endMinute       Int
  slotStepMinutes Int      @default(15)
  validFrom       DateTime?
  validTo         DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  resource ScheduleResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  service  ServiceOffering? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([resourceId, dayOfWeek, isActive])
}

model AvailabilityException {
  id          String                    @id @default(cuid())
  resourceId  String
  date        DateTime                  @db.Date
  kind        AvailabilityExceptionKind @default(TIME_OFF)
  allDay      Boolean                   @default(true)
  startMinute Int?
  endMinute   Int?
  reason      String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  resource ScheduleResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, date])
}

model AppointmentHold {
  id              String        @id @default(cuid())
  holdToken       String        @unique
  resourceId      String
  serviceId       String
  slotStart       DateTime
  slotEnd         DateTime
  channel         AgendaChannel @default(VOICE)
  callId          String?
  createdByUserId String?
  expiresAt       DateTime
  consumedAt      DateTime?
  releasedAt      DateTime?
  createdAt       DateTime      @default(now())

  resource  ScheduleResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  service   ServiceOffering  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("AgendaHoldCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([resourceId, slotStart])
  @@index([expiresAt])
}

model AgendaAppointment {
  id                String                  @id @default(cuid())
  organizationId    String
  clinicId          String?
  resourceId        String
  serviceId         String
  patientName       String
  patientPhone      String?
  patientEmail      String?
  patientDocument   String?
  slotStart         DateTime
  slotEnd           DateTime
  status            AgendaAppointmentStatus @default(PENDING)
  source            AgendaChannel           @default(DASHBOARD)
  leadId            String?
  conversationId    String?
  notes             String?                 @db.Text
  cancelReason      String?                 @db.Text
  rescheduledFromId String?
  confirmedAt       DateTime?
  reminderSentAt    DateTime?
  checkedInAt       DateTime?
  completedAt       DateTime?
  createdByUserId   String?
  assignedToUserId  String?
  callId            String?
  calendarUid       String?                 @unique
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic          Clinic?             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  resource        ScheduleResource    @relation(fields: [resourceId], references: [id])
  service         ServiceOffering     @relation(fields: [serviceId], references: [id])
  lead            Lead?               @relation("AgendaAppointmentLead", fields: [leadId], references: [id], onDelete: SetNull)
  conversation    Conversation?       @relation("AgendaAppointmentConversation", fields: [conversationId], references: [id], onDelete: SetNull)
  rescheduledFrom AgendaAppointment?  @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   AgendaAppointment[] @relation("AppointmentReschedule")
  createdBy       User?               @relation("AgendaAppointmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignedTo      User?               @relation("AgendaAppointmentAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  events AgendaAuditEvent[]

  @@unique([resourceId, slotStart])
  @@index([clinicId, slotStart, status])
  @@index([organizationId, slotStart])
  @@index([patientPhone])
  @@index([status, reminderSentAt])
}

model WaitlistEntry {
  id             String         @id @default(cuid())
  organizationId String
  clinicId       String?
  serviceId      String
  resourceId     String?
  patientName    String
  patientPhone   String?
  patientEmail   String?
  priority       Int            @default(5) // menor = más prioritario
  desiredFrom    DateTime?
  desiredTo      DateTime?
  status         WaitlistStatus @default(WAITING)
  offeredSlot    DateTime?
  offeredAt      DateTime?
  expiresAt      DateTime?
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic?           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  service      ServiceOffering   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource     ScheduleResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([serviceId, status, priority, createdAt])
  @@index([organizationId, status])
}

model AgendaAuditEvent {
  id            String          @id @default(cuid())
  appointmentId String?
  resourceId    String?
  type          AgendaEventType
  channel       AgendaChannel   @default(DASHBOARD)
  actorUserId   String?
  actorLabel    String?
  message       String?         @db.Text
  metadata      Json?
  createdAt     DateTime        @default(now())

  appointment AgendaAppointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actor       User?              @relation("AgendaEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([appointmentId, createdAt])
  @@index([type, createdAt])
}
// ============================================================================
// IDENTIDAD CONFORME (Upway Health) - Fase 1
// ----------------------------------------------------------------------------
// Upway NO transmite el RDA ni el RIPS: eso es del prestador.
// Upway certifica que la identidad y la demografia entren conformes,
// confirmadas por el paciente y con trazabilidad.
// Ver REPORTES/NOTA-INTEGRACION-SALUD-2026-09.md §4.2 y §5.
// ============================================================================

/// Transitorio = Upway no retiene la identidad para uso propio.
/// Custodia = retencion contratada con DPA (clinicas sin HIS propio).
enum IdentityRetentionMode {
  TRANSIENT
  CUSTODY
}

enum IdentityChannel {
  VOICE
  WHATSAPP
  DASHBOARD
}

enum IdentityHandoffStatus {
  PENDING
  DELIVERED
  FAILED
  SKIPPED
}

/// Identidad certificada. NO contiene ningun dato clinico, por diseno.
/// Es el prerequisito del centro de datos: sin esto no hay nada que servir
/// al HIS del cliente. La clave de match es documentType + documentNumber,
/// la misma que usa el MPI nacional.
model PatientIdentity {
  id             String  @id @default(cuid())
  organizationId String
  clinicId       String?

  // --- Identidad: catalogos cerrados, nunca texto libre ---
  documentType     String
  documentNumber   String
  givenNames       String[]
  familyNames      String[]
  birthDate        DateTime @db.Date
  sexCode          String
  municipalityCode String
  departmentCode   String

  // --- Contacto: clave del canal, no campo del RDA ---
  phoneE164 String?
  email     String?

  // --- Conformidad certificada: es la evidencia del SLA ---
  conforming      Boolean  @default(false)
  completenessPct Int      @default(0)
  issuesJson      Json?
  /// sha256 del payload canonico. Permite probar que el dato no se altero.
  recordHash      String
  confirmedAt     DateTime?
  retentionMode   IdentityRetentionMode @default(TRANSIENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic        Clinic?                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  confirmations IdentityConfirmation[]
  handoffs      IdentityHandoff[]

  @@unique([organizationId, documentType, documentNumber])
  @@index([organizationId, documentNumber])
  @@index([clinicId, createdAt])
  @@index([conforming, createdAt])
}

/// Evidencia de que el paciente confirmo su identidad releyendo el dato.
/// Es lo que convierte el SLA en algo contractual y verificable.
model IdentityConfirmation {
  id             String          @id @default(cuid())
  identityId     String
  channel        IdentityChannel @default(VOICE)
  method         String          @default("DIGIT_BY_DIGIT_READBACK")
  scriptText     String          @db.Text
  patientReply   String?         @db.Text
  callId         String?
  conversationId String?
  confirmedAt    DateTime        @default(now())

  identity PatientIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, confirmedAt])
  @@index([callId])
}

/// Entrega del registro conforme al HIS/HCE del cliente.
/// match-or-create: Upway entrega la clave de match y NO crea pacientes
/// por su cuenta; el HIS busca y decide si actualiza o crea.
model IdentityHandoff {
  id             String                @id @default(cuid())
  identityId     String
  targetSystem   String
  /// Id del paciente en el sistema destino, devuelto por el HIS.
  targetRef      String?
  status         IdentityHandoffStatus @default(PENDING)
  /// Evita duplicar la entrega si el HIS reintenta el mismo payload.
  idempotencyKey String                @unique
  attempts       Int                   @default(0)
  lastError      String?               @db.Text
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  identity PatientIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, status])
  @@index([status, createdAt])
}

/// Cliente maquina-a-maquina: el HIS/HCE del cliente que consume el registro
/// conforme por API. La llave se guarda hasheada: el texto en claro se muestra
/// una sola vez, al momento de crearla.
model ApiClient {
  id              String    @id @default(cuid())
  organizationId  String
  clinicId        String?
  name            String
  /// sha256 de la llave. La llave en claro nunca se persiste.
  keyHash         String    @unique
  /// Prefijo publico para identificar la llave en logs y soporte.
  keyPrefix       String
  isActive        Boolean   @default(true)
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic?      @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
}


/// Onboarding de las verticales no-clinicas (Inmobiliaria / Center).
/// Antes vivia solo en memoria del navegador: si el cliente recargaba a mitad
/// perdia todo y el caso quedaba trazado unicamente por correo.
model VerticalOnboardingSession {
  id              String                   @id @default(cuid())
  userId          String
  organizationId  String?
  clinicId        String?
  /// Segmento del wizard: 'inmobiliaria' | 'center' (lib/onboarding/types.ts).
  segment         String
  status          VerticalOnboardingStatus @default(DRAFT)
  /// Indice de la etapa actual (0-based) para reanudar donde quedo.
  currentStep     Int                      @default(0)
  progressPercent Int                      @default(0)
  /// Respuestas del wizard serializadas en JSON (clave = id del campo).
  answers         String?                  @db.Text
  /// Ref del caso enviado a revision: se conserva entre reintentos.
  caseRef         String?
  submittedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, segment])
  @@index([segment, status])
}

/// Ciclo de vida del onboarding vertical: mismo vocabulario que el de Health,
/// pero separado para no atar las verticales no-clinicas al enum clinico.
enum VerticalOnboardingStatus {
  DRAFT
  IN_PROGRESS
  PENDING_REVIEW
  NEEDS_CHANGES
  APPROVED
  ACTIVE
  BLOCKED
  ARCHIVED
}
