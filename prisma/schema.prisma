generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. MODELOS DE SEGURIDAD (NEXTAUTH)
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Para que tus clientes entren con su clave

  accounts                Account[]
  sessions                Session[]
  tiendas                 Tienda[]  // Enlace directo al negocio de tu cliente
  ownedOrganizations      Organization[] @relation("OrganizationOwner")
  organizationMemberships  OrganizationMember[]
  billingAccessCodes      BillingAccessCode[] @relation("BillingAccessCodeCreator")
  leadAssignments         LeadAssignment[] @relation("LeadAssignmentAssignee")
  leadAssignmentHistory   LeadAssignment[] @relation("LeadAssignmentOwner")
  leadActivities          LeadActivity[] @relation("LeadActivityActor")
  leadReminders           LeadReminder[] @relation("LeadReminderCreator")
  appointmentAssignments Cita[] @relation("AppointmentAssignee")
  createdLeads            Lead[] @relation("LeadCreator")
  assignedLeads           Lead[] @relation("LeadAssignee")
}

enum VerticalType {
  BUSINESS
  HEALTH
  HYBRID
}

enum HealthOnboardingStatus {
  DRAFT
  IN_PROGRESS
  PENDING_REVIEW
  NEEDS_CHANGES
  APPROVED
  TESTING
  ACTIVE
  PAUSED
  BLOCKED
  ARCHIVED
}

enum HealthOnboardingStepStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  PENDING_REVIEW
  APPROVED
  REJECTED
  BLOCKED
}

enum HealthApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum BillingAccessState {
  TRIAL
  ACTIVE
  PENDING_PAYMENT
  PAUSED
  SUSPENDED
  CANCELLED
}

enum BillingAccessType {
  TRIAL
  INVITE
  GIFT
}

enum LeadSource {
  WHATSAPP
  VOICE
  WEB_FORM
  LANDING_PAGE
  REFERRAL
  MANUAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  APPOINTMENT_BOOKED
  FOLLOW_UP
  CLOSED_WON
  CLOSED_LOST
  ARCHIVED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ConversationStatus {
  ACTIVE
  WAITING
  RESOLVED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
  REBOOKED
}

enum ReminderStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum ActivityType {
  LEAD_CREATED
  LEAD_QUALIFIED
  LEAD_ASSIGNED
  MESSAGE_RECEIVED
  MESSAGE_SENT
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  REMINDER_SENT
  FOLLOW_UP_SCHEDULED
  NOTE_ADDED
  STATUS_CHANGED
}

model Organization {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  vertical    VerticalType  @default(BUSINESS)
  verticals   VerticalType[] @default([BUSINESS])
  ownerId     String
  owner       User          @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     OrganizationMember[]
  clinics     Clinic[]
  tiendas     Tienda[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("admin")
  permissions    String[]     @default([])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Clinic {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  specialty       String?
  timezone        String?      @default("UTC")
  vertical        VerticalType @default(BUSINESS)
  status          String       @default("active")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tiendas            Tienda[]
  healthProfile      HealthProfile?
  onboardingSessions HealthOnboardingSession[]
  auditLogs          HealthAuditLog[]
}

model HealthProfile {
  id                       String   @id @default(cuid())
  clinicId                 String   @unique
  specialty                String?
  appointmentMode         String?  @default("phone")
  patientContextRequired   Boolean  @default(true)
  emergencyEscalation      Boolean  @default(true)
  cancellationPolicy       String?  @db.Text
  toneProfile              String?  @default("professional")
  privacyMode              String   @default("strict")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  clinic                   Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  triageRules              HealthTriageRule[]
  faqs                     HealthFAQ[]
  handoffRules             HealthHandoffRule[]
  compliancePolicies       HealthCompliancePolicy[]
}

model HealthOnboardingSession {
  id              String                 @id @default(cuid())
  clinicId        String
  vertical        VerticalType           @default(BUSINESS)
  status          HealthOnboardingStatus @default(DRAFT)
  currentStep     String                 @default("overview")
  progressPercent Int                    @default(0)
  notes           String?                @db.Text
  ownerUserId     String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  clinic          Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  steps           HealthOnboardingStep[]
  approvals       HealthOnboardingApproval[]
}

model HealthOnboardingStep {
  id            String                    @id @default(cuid())
  sessionId     String
  stepKey       String
  title         String
  status        HealthOnboardingStepStatus @default(NOT_STARTED)
  required      Boolean                   @default(true)
  notes         String?                   @db.Text
  blockerReason String?                   @db.Text
  assigneeUserId String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  session       HealthOnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, stepKey])
}

model HealthOnboardingApproval {
  id          String             @id @default(cuid())
  sessionId   String
  entityType  String             @default("onboarding")
  entityId    String?
  requestedBy String?
  approvedBy  String?
  status      HealthApprovalStatus @default(PENDING)
  comments    String?            @db.Text
  createdAt   DateTime           @default(now())
  reviewedAt  DateTime?

  session     HealthOnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
}

model HealthAuditLog {
  id           String   @id @default(cuid())
  clinicId     String
  entityType   String
  entityId     String
  action       String
  performedBy  String?
  beforeJson   Json?
  afterJson    Json?
  createdAt    DateTime @default(now())

  clinic       Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, entityType, createdAt])
}

model WebhookEventLog {
  id          String   @id @default(cuid())
  provider    String
  eventType   String
  status      String   @default("received")
  clinicId    String?
  tenantId    String?
  entityType  String?
  entityId    String?
  performedBy String?
  payloadJson Json?
  metadataJson Json?
  createdAt   DateTime @default(now())

  @@index([provider, createdAt])
  @@index([clinicId, createdAt])
}

model HealthTriageRule {
  id            String   @id @default(cuid())
  profileId     String
  name          String
  condition     String   @db.Text
  severity      String   @default("medium")
  action        String   @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       HealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model HealthFAQ {
  id            String   @id @default(cuid())
  profileId     String
  question      String   @db.Text
  answer        String   @db.Text
  category      String   @default("general")
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       HealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model HealthHandoffRule {
  id             String   @id @default(cuid())
  profileId      String
  triggerType    String
  destination    String
  escalationMode String   @default("human")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile        HealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model HealthCompliancePolicy {
  id            String   @id @default(cuid())
  profileId     String
  title         String
  body          String   @db.Text
  version       String   @default("v1")
  isRequired    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       HealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model BillingAccessCode {
  id              String             @id @default(cuid())
  code            String             @unique
  label           String
  description     String?
  state           BillingAccessState @default(TRIAL)
  type            BillingAccessType  @default(TRIAL)
  allowedRole     String?            @default("clinic-admin")
  isActive        Boolean            @default(true)
  expiresAt       DateTime?
  createdByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  createdBy       User?              @relation("BillingAccessCodeCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([isActive, expiresAt])
  @@index([code])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ==========================================
// 2. MODELOS DE UPWAY BUSINESS (SAAS)
// ==========================================

model Tienda {
  id                  String   @id @default(cuid())
  userId              String
  organizationId      String?
  clinicId            String?
  nombre              String

  // 🏭 Segmento de negocio (inmobiliaria, drogueria, retail, supermercado, general)
  segment             String   @default("general")

  // 🤖 Personalidad del Bot
  agentName           String?
  systemPrompt        String?  @db.Text

  // 🔥 CAMPOS META WHATSAPP Y HANDOFF
  telefono            String?  // El número oficial de la empresa en Meta
  telefonoAdmin       String?  // Celular personal del dueño para Human Handoff
  metaPhoneNumberId   String?
  metaWabaId          String?
  metaAccessToken     String?  @db.Text
  isWhatsAppActive    Boolean  @default(false)
  whatsappStatus      String   @default("PENDING") // 🟢 Para el letrero verde inteligente del frontend
  isAiActive          Boolean  @default(true)      // 🛑 Botón del panel: true = IA responde, false = Humano responde

  // 🎙️ CAMPOS VAPI (Agentes de Voz)
  vapiAssistantId     String?
  vapiPhoneNumber     String?
  isVapiActive        Boolean  @default(false)

  // 🗑️ (Se eliminaron los campos de Google Calendar por el pivot estratégico)

  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization        Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clinic              Clinic?        @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  productos           Producto[]
  llamadas            LlamadaLog[]
  leads               Lead[]
  conversations       Conversation[] // 💬 Relación con el buzón omnicanal
  citas               Cita[]         // 📅 Relación con la Agenda Nativa Upway
}

model Producto {
  id          String   @id @default(cuid())
  tiendaId    String
  nombre      String
  descripcion String?
  precio      Float
  stock       Int      @default(0)

  tienda      Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
}

// ==========================================
// 3. MOTOR DE FACTURACIÓN (VOZ)
// ==========================================

model LlamadaLog {
  id                String   @id @default(cuid())
  tiendaId          String
  vapiCallId        String   @unique
  direction         String   // "inbound" o "outbound"
  durationMinutes   Float
  vapiCost          Float    // Lo que te cobra Vapi a ti
  upwayBilledCost   Float    // Lo que Upway le cobra a la IPS (con tu margen)
  status            String   // "completed", "failed", "no_answer", etc.
  createdAt         DateTime @default(now())

  tienda            Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
}

// ==========================================
// 4. MÓDULO CRM (LEADS Y PACIENTES)
// ==========================================

model Lead {
  id               String        @id @default(cuid())
  tiendaId         String
  nombre           String
  documento        String?       // Cédula, NIT o Pasaporte
  motivo           String?       @db.Text // El resumen de la consulta o intención
  origen           LeadSource    @default(WHATSAPP)
  estado           LeadStatus    @default(NEW)
  prioridad        LeadPriority  @default(MEDIUM)
  phone            String?
  email            String?
  city             String?
  qualityScore     Int           @default(0)
  note             String?       @db.Text
  createdByUserId  String?
  assignedToUserId String?
  lastContactAt    DateTime?
  closedAt         DateTime?
  metadataJson     Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tienda        Tienda            @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  createdBy     User?             @relation("LeadCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignedTo    User?             @relation("LeadAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  conversations Conversation[]
  assignments   LeadAssignment[]
  activities    LeadActivity[]
  reminders     LeadReminder[]
  appointments  Cita[]

  @@index([tiendaId, estado])
  @@index([tiendaId, prioridad])
  @@index([assignedToUserId])
}

model LeadAssignment {
  id               String   @id @default(cuid())
  leadId           String
  userId           String
  assignedByUserId String?
  status           String   @default("active")
  reason           String?  @db.Text
  assignedAt       DateTime @default(now())
  unassignedAt     DateTime?

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user       User  @relation("LeadAssignmentAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("LeadAssignmentOwner", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([leadId, status])
  @@index([userId, status])
}

model LeadActivity {
  id           String       @id @default(cuid())
  leadId       String
  actorUserId  String?
  type         ActivityType
  summary      String?      @db.Text
  metadataJson Json?
  createdAt    DateTime     @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation("LeadActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([actorUserId, createdAt])
}

model LeadReminder {
  id              String        @id @default(cuid())
  leadId          String
  appointmentId   String?
  conversationId  String?
  createdByUserId String?
  channel         String        @default("whatsapp")
  status          ReminderStatus @default(PENDING)
  message         String?       @db.Text
  scheduledFor    DateTime
  sentAt          DateTime?
  createdAt       DateTime      @default(now())

  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  appointment  Cita?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("LeadReminderCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([leadId, status, scheduledFor])
  @@index([scheduledFor])
}

// ==========================================
// 5. BUZÓN OMNICANAL Y MÉTRICAS META (CHAT EN VIVO)
// ==========================================

model Conversation {
  id           String             @id @default(cuid())
  tiendaId     String
  leadId       String?
  clientPhone  String             // El número de WhatsApp del cliente
  clientName   String?            // Nombre del cliente
  status       ConversationStatus @default(ACTIVE)
  metaCategory String?            // "service", "utility", "marketing" (Métricas de cobro Meta)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  tienda       Tienda             @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  lead         Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages     Message[]
  appointments Cita[]
  reminders    LeadReminder[]

  // Un cliente solo debería tener una conversación activa por tienda a la vez
  @@unique([tiendaId, clientPhone])
  @@index([leadId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  metaMessageId  String?          @unique // ID real de Meta para cruzar los estados (entregado/leído)
  senderRole     String           @default("USER") // Quién envió: "USER", "AI", "HUMAN", "SYSTEM"
  direction      MessageDirection @default(INBOUND)
  messageType    String           @default("text")
  content        String           @db.Text
  status         MessageStatus    @default(SENT) // "sent", "delivered", "read", "failed" (Check azul)
  metadataJson   Json?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ==========================================
// 6. AGENDA NATIVA UPWAY (CITAS)
// ==========================================

model Cita {
  id               String            @id @default(cuid())
  tiendaId         String
  leadId           String?
  conversationId   String?
  assignedToUserId String?
  clienteNombre    String
  clienteTelefono  String
  fechaHora        DateTime
  estado           AppointmentStatus @default(CONFIRMED)
  durationMinutes  Int               @default(30)
  location         String?
  notes            String?           @db.Text
  cancelReason     String?           @db.Text
  source           String            @default("manual")
  createdByUserId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tienda       Tienda       @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("AppointmentAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  reminders    LeadReminder[]

  @@index([tiendaId, fechaHora])
  @@index([leadId])
  @@index([conversationId])
}