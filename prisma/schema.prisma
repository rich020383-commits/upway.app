generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. MODELOS DE SEGURIDAD (NEXTAUTH)
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Para que tus clientes entren con su clave
  
  accounts      Account[]
  sessions      Session[]
  tiendas       Tienda[]  // Enlace directo al negocio de tu cliente
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ==========================================
// 2. MODELOS DE UPWAY BUSINESS (SAAS)
// ==========================================

model Tienda {
  id                  String   @id @default(cuid())
  userId              String
  nombre              String
  
  // 🤖 Personalidad del Bot
  agentName           String?
  systemPrompt        String?  @db.Text
  
  // 🔥 CAMPOS META WHATSAPP
  telefono            String?  
  metaPhoneNumberId   String?  
  metaWabaId          String?  
  metaAccessToken     String?  @db.Text
  isWhatsAppActive    Boolean  @default(false)

  // 🎙️ CAMPOS VAPI (Agentes de Voz)
  vapiAssistantId     String?  
  vapiPhoneNumber     String?  
  isVapiActive        Boolean  @default(false)

  // 📅 INTEGRACIÓN GOOGLE CALENDAR (NUEVO)
  googleRefreshToken  String?  @db.Text
  googleCalendarId    String?  @default("primary")
  
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productos           Producto[]
  llamadas            LlamadaLog[] 
}

model Producto {
  id          String   @id @default(cuid())
  tiendaId    String
  nombre      String
  descripcion String?
  precio      Float
  stock       Int      @default(0)
  
  tienda      Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
}

// ==========================================
// 3. MOTOR DE FACTURACIÓN (VOZ)
// ==========================================

model LlamadaLog {
  id                String   @id @default(cuid())
  tiendaId          String
  vapiCallId        String   @unique
  direction         String   // "inbound" o "outbound"
  durationMinutes   Float
  vapiCost          Float    // Lo que te cobra Vapi a ti
  upwayBilledCost   Float    // Lo que Upway le cobra a la IPS (con tu margen)
  status            String   // "completed", "failed", "no_answer", etc.
  createdAt         DateTime @default(now())

  tienda            Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
}