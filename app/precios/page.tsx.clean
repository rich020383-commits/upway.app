};

type GenericPlan = {
  id: string;
  name: string;
  tagline: string;
  monthlyCOP: number;
  setupCOP: number;
  includedMinutes: number;
  includedNumbers: number;
  concurrentCalls: number;
  overageCOP: number;
  features: string[];
  bestFor: string;
  target?: string[];
  serviceLine?: string;
  isCustom?: boolean;
  requiresApproval?: boolean;
};
function FacilityBadge({ type }: { type: string }) {
  const facility = FACILITY_TYPE_OPTIONS.find((f) => f.id === type);
  if (!facility) return null;
  return (
    <span className="inline-flex items-center rounded-full bg-[#edf5ff] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-[#1b5ed6]">
      {facility.label}
    </span>
  );
}

function PlanCard({ plan, vertical, isFeatured = false }: { plan: GenericPlan; vertical: VerticalId; isFeatured?: boolean }) {
  const isCustom = plan.monthlyCOP === 0;
  const v = VERTICAL_INFO[vertical];
  const accent = v.accent;
  const accentLight = v.accentLight;
  return (
    <div
      id={plan.id}
      className={`relative flex flex-col rounded-[24px] border p-6 transition-all hover:-translate-y-1 hover:shadow-xl ${isFeatured ? `border-[${accent}] bg-gradient-to-br from-[${v.textDark}] to-[${accent}] text-white shadow-2xl` : 'border-slate-200 bg-white shadow-md'}`}
    >
      {isFeatured && (
        <div className="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full px-4 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-white shadow-lg" style={{ backgroundColor: accent }}>
          MÃ¡s popular
        </div>
      )}
      <div className="mb-4">
        <h3 className={`text-xl font-black tracking-tight ${isFeatured ? 'text-white' : 'text-slate-900'}`}>{plan.name}</h3>
        <p className={`mt-1 text-sm ${isFeatured ? 'text-slate-300' : 'text-slate-500'}`}>{plan.tagline}</p>
      </div>
      {plan.target && plan.target.length > 0 && (
        <div className="mb-4 flex flex-wrap gap-1.5">
          {plan.target.map((t) => (
            <span key={t} className={`inline-flex items-center rounded-full bg-[${accentLight}] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-[${accent}]`}>
              {t}
            </span>
          ))}
        </div>
      )}
      <div className="mb-5">
        {isCustom ? (
          <span className={`text-3xl font-black ${isFeatured ? 'text-white' : 'text-slate-900'}`}>A cotizar</span>
        ) : (
          <>
            {/* Precio de venta al pÃºblico. El titular es el TOTAL con IVA, que
                es lo que el cliente paga de verdad, y la base gravable queda
                debajo en letra chica. Antes el titular era la base y el total
                iba en una lÃ­nea de texto pequeÃ±o: la tarjeta se leÃ­a mÃ¡s
                barata de lo que es. */}
            <div className="flex items-baseline gap-2">
              <span className={`text-3xl font-black ${isFeatured ? 'text-white' : 'text-slate-900'}`}>
                {formatCOP(withIVA(plan.monthlyCOP))}
              </span>
              <span className="text-sm text-slate-500">/mes</span>
            </div>
            <p className="mt-1 text-xs text-slate-400">IVA 19% incluido Â· base sin IVA {formatCOP(plan.monthlyCOP)}</p>
          </>
        )}
      </div>
      <div className={`mb-5 space-y-2 text-sm ${isFeatured ? 'text-slate-200' : 'text-slate-600'}`}>
        <div className="flex items-center gap-2"><span>{plan.includedNumbers} nÃºmero{plan.includedNumbers > 1 ? 's' : ''}</span></div>
        <div className="flex items-center gap-2"><span>{plan.includedMinutes.toLocaleString('es-CO')} min/mes</span></div>
        <div className="flex items-center gap-2"><span>Hasta {plan.concurrentCalls} simultánea{plan.concurrentCalls > 1 ? 's' : ''}</span></div>
        {plan.overageCOP > 0 && <div className="flex items-center gap-2"><span>Minuto adicional {formatCOP(withIVA(plan.overageCOP))} con IVA</span></div>}
        
      </div>
      <ul className="mb-6 flex-1 space-y-2">
        {plan.features.map((f, i) => (
          <li key={i} className={`flex items-start gap-2 text-sm ${isFeatured ? 'text-slate-200' : 'text-slate-600'}`}>
            <span className={`mt-0.5 text-[${accent}]`}>âœ“</span><span>{f}</span>
          </li>
        ))}
      </ul>
      /* IDENTITY_MODULE_REMOVED_START */
        
          
          
          
        </div>
      )}
      <div className="mt-auto space-y-3">
        <Link href={`/login?segment=${vertical}&plan=${plan.id}`} className={`block rounded-full py-3 text-center text-sm font-bold transition-all ${isFeatured ? 'bg-white text-[#0f172a] hover:bg-slate-100' : 'bg-[#1b5ed6] text-white hover:bg-[#1548a8]'}`}>
          {isCustom ? 'Contactar ventas' : 'Empezar ahora'}
        </Link>
        {plan.setupCOP > 0 && <p className="mt-1 text-xs text-slate-400">Implementación única {formatCOP(withIVA(plan.setupCOP))} con IVA</p>}
      </div>
      {plan.requiresApproval && (
        <div className={`mt-4 rounded-xl p-3 text-xs ${isFeatured ? 'bg-white/10 text-slate-200' : 'bg-amber-50 text-amber-700'}`}>
          Requiere ampliacion de capacidad (lo tramita Upway)
        </div>
      )}

function VerticalSection({ vertical, plans, featuredId }: { vertical: VerticalId; plans: GenericPlan[]; featuredId?: string }) {
  const v = VERTICAL_INFO[vertical];
  const accent = v.accent;
  const accentLight = v.accentLight;

  return (
    <section id={`precios-${vertical}`} className="py-16 border-b border-slate-100">
      <div className="mx-auto max-w-7xl px-4">
        <div className="text-center mb-12">
          <div className="inline-flex items-center rounded-full bg-[#000] px-3 py-1 text-[11px] font-bold uppercase tracking-[0.14em] mb-3" style={{ backgroundColor: accentLight }}>
            {v.label}
          </div>
          <h2 className="text-3xl font-black tracking-tight sm:text-4xl">{v.subtitle}</h2>
          <p className="mt-4 text-slate-500 max-w-2xl mx-auto">
            Voz IA 24/7, minutos incluidos, números dedicados y minuto adicional único. Todos los precios incluyen IVA (19%).
          </p>
        </div>
        <div className="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {plans.map((plan) => (
            <PlanCard key={plan.id} plan={plan} vertical={vertical} isFeatured={plan.id === featuredId} />
          ))}
        </div>
      </div>
    </section>
  );
}

export default function PreciosPage() {
  const [activeVertical, setActiveVertical] = useState<VerticalId>('health');

  const healthStandard = ALL_HEALTH_PLANS.filter((p: GenericPlan) => p.monthlyCOP > 0);
  const healthEnterprise = HEALTH_PLANS_ENTERPRISE.filter((p: GenericPlan) => p.monthlyCOP > 0);

  return (
    <div className="min-h-screen bg-[#f4faff]">
