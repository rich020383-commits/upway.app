const VERTICAL_INFO: Record<VerticalId, { label: string; subtitle: string; accent: string; accentLight: string; textDark: string }> = {
  health: {
    label: 'Upway Health',
    subtitle: 'ClÃ­nicas, IPS, consultorios y EPS',
    accent: '#1b5ed6',
    accentLight: '#edf5ff',
    textDark: '#0f172a',
  },
  inmobiliaria: {
