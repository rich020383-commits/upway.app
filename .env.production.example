NODE_ENV=production
PORT=10000

# Base de datos: Aiven PostgreSQL (la app migro desde el proveedor anterior, cuya
# capa gratuita se agoto). Formato real del panel de Aiven:
#   postgresql://avnadmin:PASSWORD@usuario-db-proyecto.aivencloud.com:12132/defaultdb?sslmode=require
# NO agregues pgbouncer=true: Aiven entrega un unico endpoint directo, sin pooler
# separado. OBLIGATORIA: lib/prisma.ts aborta el arranque en produccion si no hay
# ninguna URL de base de datos configurada.
# Acota el pool: max_connections=20 (17 usables). Prisma abre (cpus * 2 + 1) por
# instancia y el listener retiene 1 conexion permanente.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require&connection_limit=5&pool_timeout=20"
# (Opcional) CA de Aiven, para verificacion estricta del certificado en el
# listener (LISTEN/NOTIFY). Ver lib/listener.ts.
DATABASE_CA_CERT=

# Transferencia a asesor humano (handoff WhatsApp -> numero de Upway)
HUMAN_TRANSFER_NUMBER="57XXXXXXXXX"

# ENDURECIMIENTO (AUDITORIA-2026-09) — OBLIGATORIO EN PRODUCCION
# Secreto compartido para POST /api/webhooks/events. Si falta, el endpoint
# responde 503 en produccion (fail-closed). Generar con: openssl rand -hex 32
WEBHOOK_EVENTS_SECRET=

# Rate limit de /api/sophie (default: 30 peticiones por 60s por IP)
SOPHIE_RATE_LIMIT=30
SOPHIE_RATE_WINDOW_MS=60000
