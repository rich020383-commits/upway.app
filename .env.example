# ==========================================
# 1. SERVIDOR Y BASE DE DATOS
# ==========================================
NODE_ENV=production
PORT=10000
# Base de datos: Aiven PostgreSQL (la app migro desde Neon, cuya capa gratuita
# se agoto). Formato real del panel de Aiven:
#   postgresql://avnadmin:PASSWORD@usuario-db-proyecto.aivencloud.com:12132/defaultdb?sslmode=require
# NO agregues pgbouncer=true: Aiven entrega un unico endpoint directo, sin pooler
# separado (a diferencia de Neon).
#
# SI conviene acotar el pool. Medido en esta instancia:
#   max_connections = 20, menos 3 reservadas para superusuario = 17 usables.
# Prisma abre por defecto (cpus * 2 + 1) conexiones POR INSTANCIA, y el listener
# de LISTEN/NOTIFY (lib/listener.ts) mantiene 1 conexion permanente. Sin tope,
# varios workers pueden agotar las 17 y aparecer "too many clients already".
#   connection_limit=5  -> 5 (Prisma) + 1 (listener) = 6 de 17. Margen sano.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require&connection_limit=5&pool_timeout=20"
# (Opcional) CA de Aiven, para verificacion estricta del certificado en el
# listener (LISTEN/NOTIFY). Si se define, node-postgres valida la cadena real en
# vez de usar la semantica libpq de sslmode=require. Ver lib/listener.ts.
DATABASE_CA_CERT=
# DIRECT_URL quedo obsoleta al eliminar la separacion pooler/directo de Neon.
# lib/database-url.ts todavia la acepta como alias, pero ya no es necesaria.
NEXTAUTH_URL=https://upway.business
NEXTAUTH_SECRET=genera_un_secreto_aleatorio_con_openssl_rand_hex_32
# Correos autorizados para los endpoints de administracion y de diagnostico
# (ver lib/admin-guard.ts). Estan protegidos de forma cerrada: sin sesion, o con
# un correo que no figure aqui, responden 403. Si la variable queda vacia, nadie
# puede usarlos (incluye a test-email y test-notify).
# Separados por coma. Ejemplo:
#   ADMIN_EMAILS=tu@upway.business,otro@upway.business
ADMIN_EMAILS=

# ==========================================
# 2. TELNYX NATIVO (VOZ, TELEFONÍA Y VOICE AI)
# ==========================================
# Estado: PENDIENTE — la captura "Upway voice core" mostraba el formulario vacío,
# sin Webhook URL ni número asignado. Dominio oficial: upway.business
# Completa estos 4 valores del portal:
#  1) API Keys -> copia la privada (KEY...) y la pública (Ed25519 hex)
#  2) Voice -> Programmable Voice -> abre "Upway voice core" -> Application ID
#  3) Numbers -> compra/asigna número y vincúlalo a "Upway voice core"
#  4) En la app "Upway voice core": Webhook URL = https://upway.business/api/voice/webhooks, API v2
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_APP_ID=
TELNYX_DEFAULT_PHONE_NUMBER=
# (Opcional) AI Assistant ya creado. Si se deja vacío, /api/voice/agents crea uno por tienda
TELNYX_AI_ASSISTANT_ID=""
# Secreto compartido servidor-a-servidor para las webhook tools del asistente
# (Agenda Premium: /api/tools/agenda). Sin esta variable el tool responde 503.
TELNYX_TOOL_SECRET=""

# 2.1 AGENDA PREMIUM UPWAY (nativa, sin Google Calendar ni terceros)
# Minutos que el agente de voz retiene un cupo antes de confirmarlo (máx. 60).
AGENDA_HOLD_TTL_MINUTES="10"
# Anticipación mínima para agendar una cita nueva (minutos).
AGENDA_MIN_LEAD_MINUTES="60"
# URL pública del backend (para que Telnyx llame a /api/voice/webhooks). Dominio oficial: upway.business
NEXT_PUBLIC_APP_URL=https://upway.business

# ==========================================
# 3. META WHATSAPP CLOUD API
# ==========================================
META_APP_SECRET=reemplaza_por_tu_app_secret
META_VERIFY_TOKEN=reemplaza_por_tu_verify_token
WHATSAPP_TOKEN=EAAB...
NEXT_PUBLIC_FACEBOOK_APP_ID=reemplaza_por_tu_facebook_app_id
NEXT_PUBLIC_META_CONFIG_ID=reemplaza_por_tu_meta_config_id
HUMAN_TRANSFER_NUMBER="57XXXXXXXXX"

# ==========================================
# 4. INTELIGENCIA ARTIFICIAL Y ASISTENTE SOPHIE
# ==========================================
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...

# ==========================================
# 5. WEBHOOKS DE SISTEMA (BOLD)
# ==========================================
# El secreto de la bitacora de eventos vive en la seccion 7 (WEBHOOK_EVENTS_SECRET).
# Ya no existe secreto de base de datos: el proveedor cambio a Aiven y el webhook
# que usaba el anterior (NEON_WEBHOOK_SECRET) se elimino en la auditoria 2026-09.
# Bold: llaves del panel -> Integraciones -> Llaves de integracion -> pestana "API pagos en linea".
#   (La pestana "Boton de pagos" NO sirve para el link de pagos: son integraciones distintas.)
# En Bold solo existen DOS llaves; no hay ninguna llamada "firma de integridad":
#  - BOLD_API_KEY    = "Llave de identidad" -> crea los links de pago (Authorization: x-api-key ...)
#  - BOLD_SECRET_KEY = "Llave secreta"      -> firma el header X-Bold-Signature del webhook
#                      /api/webhooks/bold (Bold calcula SHA256 del body + esta llave).
BOLD_API_KEY=
BOLD_SECRET_KEY=
# Alias tolerados por el codigo por si la variable ya existe en Render con otro nombre
# (basta definir UNA: el codigo toma la primera que tenga valor). NO son llaves nuevas.
BOLD_INTEGRITY_SIGNATURE=
BOLD_WEBHOOK_SECRET=
# Vigencia del link de pago, en dias (default 7). Cubre el ciclo de compra B2B en salud
# (orden de compra + aprobacion de gerencia/contabilidad). Ajustable sin deploy: 3, 5, 7...
BOLD_LINK_TTL_DAYS=7

# ==========================================
# 6. EMAIL (NOTIFICACIONES ONBOARDING)
# ==========================================
# SMTP para enviar notificaciones de onboarding al equipo de Upway
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu@gmail.com, SMTP_PASS=app_password
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=activacionplan@upway.business
SMTP_PASS=
SMTP_FROM=Upway Health <activacionplan@upway.business>
UPWAY_REVIEW_EMAIL=activacionplan@upway.business
# URL publica de la app (para links dentro de los correos del flujo de activacion)
NEXT_PUBLIC_APP_URL=https://upway.business
# Alias opcional del panel del cliente si no se usa /health
UPWAY_APP_PANEL_URL=

# ==========================================
# 7. ENDURECIMIENTO (AUDITORIA-2026-09)
# ==========================================
# Secreto compartido para POST /api/webhooks/events (bitacora de eventos de
# proveedores). Sin esta variable, en produccion el endpoint responde 503 y
# rechaza todo: fail-closed a proposito, porque esa bitacora es evidencia de
# auditoria y no puede ser envenenable por terceros.
# Generar con: openssl rand -hex 32
WEBHOOK_EVENTS_SECRET=


# Rate limit de /api/sophie (default: 30 peticiones por 60s por IP).
# Frena el abuso que agotaba la cuota pagada de los proveedores de LLM.
# Dejar vacio o en 0 desactiva el limite.
SOPHIE_RATE_LIMIT=30
SOPHIE_RATE_WINDOW_MS=60000

